diff --git a/tools/resolve_array_names.c b/tools/resolve_array_names.c
new file mode 100644
index 0000000000000000000000000000000000000000..84087cbe6658001d1dbac6d5779dcaf68ca9569e
--- /dev/null
+++ b/tools/resolve_array_names.c
@@ -0,0 +1,75 @@
+#define _GNU_SOURCE
+#include <sys/ioctl.h>
+#include <sys/syscall.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#define M1 0x7a3b9c4du
+#define M2 0x2f8e1d6bu
+#define P_READ_PHYS 0xC0285709u
+#define NAME_POOL_OFF 0x10628080ULL
+#define NAME_BLOCKS_OFF 0x48ULL
+
+struct phys_io { uint32_t pid, pad; uint64_t va, buf, size, pa_out; };
+static int fd = -1;
+static uint32_t pid;
+static uint64_t base, end, names;
+
+static int rd(uint64_t a, void *b, uint64_t n) {
+    struct phys_io p = { pid, 0, a, (uint64_t)(uintptr_t)b, n, 0 };
+    return ioctl(fd, P_READ_PHYS, &p);
+}
+static uint64_t cl(uint64_t v) { return v & 0x00ffffffffffffffULL; }
+static int ptr(uint64_t v) { v=cl(v); return v>=0x1000000000ULL && v<0x8000000000ULL && !(v&7); }
+static int inlib(uint64_t v) { v=cl(v); return v>=base && v<end; }
+
+static int fname(uint32_t idx, char *out, int cap) {
+    out[0]=0;
+    uint32_t block = idx >> 16;
+    uint32_t off = (idx & 0xffffu) * 2u;
+    uint64_t b=0;
+    if (block >= 8192 || rd(names + NAME_BLOCKS_OFF + (uint64_t)block*8, &b, 8)) return 0;
+    b=cl(b); if (!ptr(b)) return 0;
+    uint16_t h=0; if (rd(b+off,&h,2)) return 0;
+    int len=(h>>6)&0x3ff; int wide=h&1;
+    if (len<1 || len>=cap || wide) return 0;
+    if (rd(b+off+2,out,(uint64_t)len)) return 0;
+    out[len]=0;
+    for(int i=0;i<len;i++) if((unsigned char)out[i]<0x20 || (unsigned char)out[i]>0x7e) return 0;
+    return 1;
+}
+
+static int obj_name(uint64_t obj, char *out, int cap, uint64_t *cls_out, uint32_t *idx_out) {
+    uint64_t cls=0; uint32_t idx=0;
+    obj=cl(obj); if(!ptr(obj) || rd(obj+0x10,&cls,8)) return 0;
+    cls=cl(cls); if(!ptr(cls) || rd(cls+0x18,&idx,4)) return 0;
+    if(cls_out)*cls_out=cls; if(idx_out)*idx_out=idx;
+    return fname(idx,out,cap);
+}
+
+int main(int argc,char **argv) {
+    if(argc<3){fprintf(stderr,"usage: resolve_array_names PID TARRAY_STRUCT [limit]\n");return 2;}
+    pid=(uint32_t)strtoul(argv[1],0,10); uint64_t ta=strtoull(argv[2],0,0);
+    int limit=argc>3?atoi(argv[3]):128; if(limit<1)limit=1; if(limit>2048)limit=2048;
+    syscall(__NR_reboot,(long)M1,(long)M2,0x1234567L,&fd); if(fd<0){perror("driver");return 3;}
+    char mp[64],line[1024]; snprintf(mp,sizeof mp,"/proc/%u/maps",pid); FILE *m=fopen(mp,"r"); if(!m)return 4;
+    while(fgets(line,sizeof line,m)){unsigned long long lo,hi,off;char pm[8];
+        if(strstr(line,"libUE4.so")&&sscanf(line,"%llx-%llx %7s %llx",&lo,&hi,pm,&off)==4){if(off==0&&!base)base=lo;if(hi>end)end=hi;}}
+    fclose(m); names=base+NAME_POOL_OFF;
+    uint8_t head[0x90]={0}; rd(names,head,sizeof head);
+    fprintf(stderr,"pid=%u lib=0x%llx-0x%llx names=0x%llx block0=0x%llx\n",pid,
+        (unsigned long long)base,(unsigned long long)end,(unsigned long long)names,
+        (unsigned long long)cl(*(uint64_t*)(head+NAME_BLOCKS_OFF)));
+    struct {uint64_t p;int n,cap;} tv={0}; if(rd(ta,&tv,sizeof tv)){fprintf(stderr,"read tarray failed\n");return 5;}
+    tv.p=cl(tv.p); printf("tarray=0x%llx data=0x%llx count=%d cap=%d\n",(unsigned long long)ta,(unsigned long long)tv.p,tv.n,tv.cap);
+    for(unsigned back=0x20;back<=0x500;back+=8){uint64_t o=ta-back,cls=0;uint32_t idx=0;char nm[160];
+        if(obj_name(o,nm,sizeof nm,&cls,&idx))printf("host off=0x%x obj=0x%llx class=0x%llx idx=%u name=%s\n",back,(unsigned long long)o,(unsigned long long)cls,idx,nm);}
+    if(tv.n<limit)limit=tv.n; uint64_t *a=calloc((size_t)limit,8); if(!a)return 6; if(rd(tv.p,a,(uint64_t)limit*8))return 7;
+    int ok=0;
+    for(int i=0;i<limit;i++){uint64_t cls=0;uint32_t idx=0;char nm[160];
+        if(obj_name(a[i],nm,sizeof nm,&cls,&idx)){printf("[%d] obj=0x%llx class=0x%llx idx=%u name=%s%s\n",i,(unsigned long long)cl(a[i]),(unsigned long long)cls,idx,nm,inlib(a[i])?" INLIB":"");ok++;}}
+    fprintf(stderr,"resolved=%d/%d\n",ok,limit); free(a); return ok?0:1;
+}
diff --git a/tools/scan_actor_arrays.c b/tools/scan_actor_arrays.c
new file mode 100644
index 0000000000000000000000000000000000000000..829ae1f48f7e0b9262a8c43c3f55a66f97893ff8
--- /dev/null
+++ b/tools/scan_actor_arrays.c
@@ -0,0 +1,162 @@
+#define _GNU_SOURCE
+#include <sys/ioctl.h>
+#include <sys/syscall.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#define M1 0x7a3b9c4du
+#define M2 0x2f8e1d6bu
+#define P_READ_PHYS 0xC0285709u
+
+struct phys_io { uint32_t pid, pad; uint64_t va, buf, size, pa_out; };
+struct range { uint64_t lo, hi; };
+struct level_hit { uint64_t level, array_struct, actors; unsigned actors_off; int count; };
+
+static int fd=-1;
+static uint32_t pid;
+static uint64_t lib_lo, lib_hi;
+static struct range ranges[1024];
+static unsigned range_n;
+static struct level_hit levels[64];
+static unsigned level_n;
+
+static int rd(uint64_t va, void *buf, uint64_t size){
+    struct phys_io p={pid,0,va,(uint64_t)(uintptr_t)buf,size,0};
+    return ioctl(fd,P_READ_PHYS,&p);
+}
+static uint64_t clean(uint64_t v){ return v&0x00ffffffffffffffULL; }
+static int ptr(uint64_t v){
+    v=clean(v); return v>=0x1000000000ULL && v<0x8000000000ULL && !(v&7);
+}
+static int inlib(uint64_t v){ v=clean(v); return v>=lib_lo && v<lib_hi; }
+static int vt_object(uint64_t p){
+    uint64_t vt=0; p=clean(p);
+    return ptr(p) && rd(p,&vt,8)==0 && inlib(vt);
+}
+static int uobject_like(uint64_t p){
+    uint64_t cls=0;
+    p=clean(p);
+    if(!vt_object(p)) return 0;
+    for(unsigned off=0x8;off<=0x30;off+=8){
+        if(rd(p+off,&cls,8)==0 && vt_object(cls)) return 1;
+    }
+    return 0;
+}
+static int actor_score(uint64_t arr, int count, int *ptrs_out, int *vts_out){
+    uint64_t a[64]={0};
+    int n=count<64?count:64, ptrs=0, objects=0;
+    arr=clean(arr);
+    if(!ptr(arr) || rd(arr,a,(uint64_t)n*8)!=0) return 0;
+    for(int i=0;i<n;i++){
+        uint64_t p=clean(a[i]);
+        if(!ptr(p)) continue;
+        ptrs++;
+        if(uobject_like(p)) objects++;
+    }
+    *ptrs_out=ptrs; *vts_out=objects;
+    return ptrs*2>=n && objects>=4 && objects*3>=ptrs*2;
+}
+static void save_level(uint64_t level, uint64_t ta, uint64_t arr, unsigned off, int count){
+    for(unsigned i=0;i<level_n;i++) if(levels[i].level==level && levels[i].actors_off==off) return;
+    if(level_n<64) levels[level_n++]=(struct level_hit){level,ta,arr,off,count};
+}
+static int wanted_map(const char *line, int include_blank){
+    if(strstr(line,"[anon:libc_malloc]") || strstr(line,"[heap]")) return 1;
+    if(!include_blank) return 0;
+    const char *p=strchr(line,'/');
+    if(p || strchr(line,'[')) return 0;
+    return 1;
+}
+static void collect_maps(FILE *m, int include_blank){
+    char line[1024];
+    rewind(m); range_n=0;
+    while(fgets(line,sizeof line,m)){
+        unsigned long long lo=0,hi=0,off=0; char perm[8]={0}; int used=0;
+        if(sscanf(line,"%llx-%llx %7s %llx %*s %*s %n",&lo,&hi,perm,&off,&used)<4) continue;
+        if(strncmp(perm,"rw-p",4) || lo<0x1000000000ULL || !wanted_map(line+used,include_blank)) continue;
+        if(hi<=lo || hi-lo>0x10000000ULL) continue;
+        if(range_n<1024) ranges[range_n++]=(struct range){lo,hi};
+    }
+}
+static void scan_arrays(void){
+    uint8_t page[0x1000]; unsigned pages=0, candidates=0;
+    for(unsigned r=0;r<range_n;r++){
+        fprintf(stderr,"heap 0x%llx-0x%llx\n",(unsigned long long)ranges[r].lo,(unsigned long long)ranges[r].hi);
+        for(uint64_t at=ranges[r].lo;at<ranges[r].hi;at+=sizeof page){
+            uint64_t n=ranges[r].hi-at; if(n>sizeof page)n=sizeof page;
+            if(rd(at,page,n)!=0) continue; pages++;
+            for(uint64_t i=0;i+16<=n;i+=8){
+                uint64_t arr=clean(*(uint64_t *)(page+i));
+                int cnt=*(int *)(page+i+8), cap=*(int *)(page+i+12);
+                if(!ptr(arr) || cnt<5 || cnt>6000 || cap<cnt || cap>cnt*2+64) continue;
+                int ps=0,vs=0;
+                if(!actor_score(arr,cnt,&ps,&vs)) continue;
+                candidates++;
+                uint64_t ta=at+i;
+                fprintf(stdout,"array struct=0x%llx actors=0x%llx count=%d cap=%d sample_ptrs=%d sample_vt=%d\n",
+                    (unsigned long long)ta,(unsigned long long)arr,cnt,cap,ps,vs);
+                for(unsigned off=0x20;off<=0x500;off+=8){
+                    if(ta<off) break;
+                    uint64_t level=ta-off;
+                    if(uobject_like(level)){
+                        fprintf(stdout," level=0x%llx actors_off=0x%x\n",(unsigned long long)level,off);
+                        save_level(level,ta,arr,off,cnt);
+                    }
+                }
+                fflush(stdout);
+            }
+        }
+    }
+    fprintf(stderr,"array_scan pages=%u candidates=%u levels=%u\n",pages,candidates,level_n);
+}
+static void scan_level_refs(void){
+    uint8_t page[0x1000]; unsigned refs=0;
+    for(unsigned r=0;r<range_n;r++){
+        for(uint64_t at=ranges[r].lo;at<ranges[r].hi;at+=sizeof page){
+            uint64_t n=ranges[r].hi-at; if(n>sizeof page)n=sizeof page;
+            if(rd(at,page,n)!=0) continue;
+            for(uint64_t i=0;i+8<=n;i+=8){
+                uint64_t q=clean(*(uint64_t *)(page+i));
+                for(unsigned li=0;li<level_n;li++){
+                    if(q!=levels[li].level) continue;
+                    uint64_t field=at+i;
+                    for(unsigned off=0x20;off<=0x300;off+=8){
+                        if(field<off) break;
+                        uint64_t world=field-off;
+                        if(uobject_like(world)){
+                            fprintf(stdout,"world_candidate world=0x%llx level_off=0x%x level=0x%llx actors_off=0x%x count=%d ref=0x%llx\n",
+                                (unsigned long long)world,off,(unsigned long long)q,levels[li].actors_off,
+                                levels[li].count,(unsigned long long)field);
+                            refs++;
+                        }
+                    }
+                }
+            }
+        }
+    }
+    fprintf(stderr,"world_refs=%u\n",refs);
+}
+int main(int argc,char **argv){
+    if(argc<2){fprintf(stderr,"usage: scan_actor_arrays PID [blank]\n");return 2;}
+    pid=(uint32_t)strtoul(argv[1],0,10);
+    syscall(__NR_reboot,(long)M1,(long)M2,0x1234567L,&fd);
+    if(fd<0){fprintf(stderr,"driver fd=%d\n",fd);return 3;}
+    char mp[64],line[1024]; snprintf(mp,sizeof mp,"/proc/%u/maps",pid);
+    FILE *m=fopen(mp,"r"); if(!m){perror("maps");return 4;}
+    while(fgets(line,sizeof line,m)){
+        unsigned long long lo=0,hi=0,off=0; char perm[8]={0};
+        if(!strstr(line,"libUE4.so"))continue;
+        if(sscanf(line,"%llx-%llx %7s %llx",&lo,&hi,perm,&off)!=4)continue;
+        if(off==0&&!lib_lo)lib_lo=lo; if(hi>lib_hi)lib_hi=hi;
+    }
+    collect_maps(m,argc>2);
+    fprintf(stderr,"pid=%u lib=0x%llx-0x%llx ranges=%u mode=%s\n",pid,
+        (unsigned long long)lib_lo,(unsigned long long)lib_hi,range_n,argc>2?"native+blank":"libc");
+    scan_arrays();
+    if(level_n) scan_level_refs();
+    fclose(m);
+    return level_n?0:1;
+}
diff --git a/tools/scan_gworld.c b/tools/scan_gworld.c
new file mode 100644
index 0000000000000000000000000000000000000000..313a6884a0110bf6529292357064efc515bac2ad
--- /dev/null
+++ b/tools/scan_gworld.c
@@ -0,0 +1,149 @@
+#define _GNU_SOURCE
+#include <sys/ioctl.h>
+#include <sys/syscall.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#define M1 0x7a3b9c4du
+#define M2 0x2f8e1d6bu
+#define P_READ_PHYS 0xC0285709u
+
+struct phys_io { uint32_t pid, pad; uint64_t va, buf, size, pa_out; };
+static int fd = -1;
+static uint32_t pid = 0;
+static uint64_t base = 0, lib_end = 0;
+static int rd(uint64_t va, void *buf, uint64_t size) {
+    struct phys_io p = { pid, 0, va, (uint64_t)(uintptr_t)buf, size, 0 };
+    return ioctl(fd, P_READ_PHYS, &p);
+}
+static uint64_t clean(uint64_t v) { return v & 0x00ffffffffffffffULL; }
+static int ptr(uint64_t v) {
+    v = clean(v);
+    return v >= 0x1000000000ULL && v < 0x8000000000ULL && !(v & 7);
+}
+static int inlib(uint64_t v) { v=clean(v); return v>=base && v<lib_end; }
+static int object_like(uint64_t p) {
+    uint64_t vt=0, cls=0, cvt=0;
+    p=clean(p);
+    if (!ptr(p) || rd(p,&vt,8)!=0 || !inlib(vt)) return 0;
+    if (rd(p+0x10,&cls,8)!=0 || !ptr(cls)) return 0;
+    cls=clean(cls);
+    if (rd(cls,&cvt,8)!=0 || !inlib(cvt)) return 0;
+    return 1;
+}
+static unsigned actor_score(uint64_t arr, int cnt) {
+    uint64_t a[32]={0};
+    int n=cnt<32?cnt:32, pointerish=0, objects=0;
+    arr=clean(arr);
+    if (!ptr(arr) || rd(arr,a,(uint64_t)n*8)!=0) return 0;
+    for (int i=0;i<n;i++) {
+        uint64_t p=clean(a[i]);
+        if (!p) continue;
+        if (!ptr(p)) continue;
+        pointerish++;
+        if (objects<8 && object_like(p)) objects++;
+    }
+    if (pointerish<3 || objects<2) return 0;
+    return (unsigned)(pointerish*10+objects);
+}
+
+#define SEEN_N 65536u
+static uint64_t seen[SEEN_N];
+static int seen_add(uint64_t p) {
+    uint32_t h=(uint32_t)((p>>4)^(p>>21)^(p>>37))&(SEEN_N-1);
+    for (uint32_t k=0;k<32;k++) {
+        uint32_t i=(h+k)&(SEEN_N-1);
+        if (seen[i]==p) return 0;
+        if (!seen[i]) { seen[i]=p; return 1; }
+    }
+    return 0;
+}
+
+static unsigned probe_world(uint64_t global, uint64_t world) {
+    uint8_t wb[0x200];
+    world=clean(world);
+    if (!seen_add(world) || !object_like(world) || rd(world,wb,sizeof wb)!=0) return 0;
+    unsigned hits=0;
+    for (unsigned wo=0x20;wo<=0x1b0;wo+=8) {
+        uint64_t level=clean(*(uint64_t *)(wb+wo));
+        if (!ptr(level) || !object_like(level)) continue;
+        uint8_t lb[0x380];
+        if (rd(level,lb,sizeof lb)!=0) continue;
+        for (unsigned ao=0x40;ao<=0x360;ao+=8) {
+            uint64_t arr=clean(*(uint64_t *)(lb+ao));
+            int cnt=*(int *)(lb+ao+8), cap=*(int *)(lb+ao+12);
+            if (!ptr(arr) || cnt<3 || cnt>10000 || cap<cnt || cap>20000) continue;
+            unsigned score=actor_score(arr,cnt);
+            if (!score) continue;
+            printf("candidate global_off=0x%llx global=0x%llx world=0x%llx level_off=0x%x level=0x%llx actors_off=0x%x arr=0x%llx cnt=%d cap=%d score=%u\n",
+                (unsigned long long)(global-base),(unsigned long long)global,
+                (unsigned long long)world,wo,(unsigned long long)level,ao,
+                (unsigned long long)arr,cnt,cap,score);
+            fflush(stdout); hits++;
+        }
+    }
+    return hits;
+}
+
+int main(int argc, char **argv) {
+    if (argc != 2) { fprintf(stderr, "usage: scan_gworld PID\n"); return 2; }
+    pid = (uint32_t)strtoul(argv[1], 0, 10);
+    syscall(__NR_reboot, (long)M1, (long)M2, 0x1234567L, &fd);
+    if (fd < 0) { fprintf(stderr, "driver fd=%d\n", fd); return 3; }
+
+    char mp[64], line[768]; snprintf(mp, sizeof mp, "/proc/%u/maps", pid);
+    FILE *m = fopen(mp, "r"); if (!m) { perror("maps"); return 4; }
+    while (fgets(line, sizeof line, m)) {
+        unsigned long long lo=0, hi=0, off=0; char perms[8]={0};
+        if (!strstr(line, "libUE4.so")) continue;
+        if (sscanf(line, "%llx-%llx %7s %llx", &lo, &hi, perms, &off) != 4) continue;
+        if (off == 0 && !base) base = lo;
+        if (hi > lib_end) lib_end = hi;
+    }
+    rewind(m);
+    fprintf(stderr, "base=0x%llx end=0x%llx fd=%d\n",
+        (unsigned long long)base,(unsigned long long)lib_end,fd);
+
+    unsigned hits=0, objects=0, vtglobals=0, chunks=0;
+    uint8_t *chunk=malloc(0x1000); if(!chunk) return 5;
+    while (fgets(line, sizeof line, m)) {
+        unsigned long long lo=0, hi=0, off=0; char perms[8]={0};
+        if (!strstr(line, "libUE4.so")) continue;
+        if (sscanf(line, "%llx-%llx %7s %llx", &lo, &hi, perms, &off) != 4) continue;
+        if (strncmp(perms,"rw-p",4) || off<0xe000000ULL) continue;
+        fprintf(stderr,"scan 0x%llx-0x%llx off=0x%llx\n",lo,hi,off);
+        for(uint64_t at=lo;at<hi;at+=0x1000) {
+            uint64_t n=hi-at; if(n>0x1000)n=0x1000;
+            if(rd(at,chunk,n)!=0) continue; chunks++;
+            for(uint64_t i=0;i+8<=n;i+=8) {
+                uint64_t world=clean(*(uint64_t *)(chunk+i));
+                if(!ptr(world) || inlib(world)) continue;
+                uint64_t vt0=0;
+                if(rd(world,&vt0,8)==0 && inlib(vt0)){
+                    if(vtglobals<20){
+                        fprintf(stderr," vtglobal(off=0x%llx ptr=0x%llx vt=0x%llx)",
+                            (unsigned long long)((at+i)-base),(unsigned long long)world,
+                            (unsigned long long)clean(vt0));
+                        uint64_t dump[64]={0};
+                        if(rd(world,dump,sizeof dump)==0){
+                            for(unsigned di=0;di<64;di++){
+                                if((di&3)==0) fprintf(stderr," object+0x%03x:",di*8);
+                                fprintf(stderr," %016llx",(unsigned long long)dump[di]);
+                                if((di&3)==3) fputc(10,stderr);
+                            }
+                        }
+                    }
+                    vtglobals++;
+                }
+                if(object_like(world)) objects++;
+                hits += probe_world(at+i,world);
+            }
+        }
+    }
+    fclose(m); free(chunk);
+    fprintf(stderr,"chunks=%u vt_globals=%u object_globals=%u hits=%u\n",chunks,vtglobals,objects,hits);
+    return hits?0:1;
+}
diff --git a/tools/scan_level_objects.c b/tools/scan_level_objects.c
new file mode 100644
index 0000000000000000000000000000000000000000..2d9472bc328f71ef80edfc019590afce09c9e0d6
--- /dev/null
+++ b/tools/scan_level_objects.c
@@ -0,0 +1,115 @@
+#define _GNU_SOURCE
+#include <sys/ioctl.h>
+#include <sys/syscall.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#define M1 0x7a3b9c4du
+#define M2 0x2f8e1d6bu
+#define P_READ_PHYS 0xC0285709u
+struct phys_io{uint32_t pid,pad;uint64_t va,buf,size,pa_out;};
+struct range{uint64_t lo,hi;};
+struct hit{uint64_t level,arr;unsigned off;int count;};
+static int fd=-1;static uint32_t pid;static uint64_t base,end;
+static struct range ranges[1024];static unsigned rn;static struct hit hits[128];static unsigned hn;
+static int rd(uint64_t a,void*b,uint64_t n){struct phys_io p={pid,0,a,(uint64_t)(uintptr_t)b,n,0};return ioctl(fd,P_READ_PHYS,&p);}
+static uint64_t cl(uint64_t v){return v&0x00ffffffffffffffULL;}
+static int ptr(uint64_t v){v=cl(v);return v>=0x1000000000ULL&&v<0x8000000000ULL&&!(v&7);}
+static int inlib(uint64_t v){v=cl(v);return v>=base&&v<end;}
+static int exact_uobject(uint64_t p){
+    uint64_t q[4]={0},cvt=0;p=cl(p);
+    if(!ptr(p)||rd(p,q,sizeof q)!=0||!inlib(q[0]))return 0;
+    uint64_t cls=cl(q[2]);
+    if(!ptr(cls)||cls==p||rd(cls,&cvt,8)!=0||!inlib(cvt))return 0;
+    return 1;
+}
+static int vt_object(uint64_t p){
+    uint64_t vt=0; p=cl(p);
+    return ptr(p)&&!inlib(p)&&rd(p,&vt,8)==0&&inlib(vt);
+}
+static int actor_array(uint64_t arr,int count,int*out_obj){
+    uint64_t a[64]={0};int n=count<64?count:64,ps=0,os=0;
+    if(!ptr(arr)||rd(cl(arr),a,(uint64_t)n*8)!=0)return 0;
+    for(int i=0;i<n;i++){
+        uint64_t p=cl(a[i]);if(!ptr(p)||inlib(p))continue;ps++;
+        if(vt_object(p))os++;
+    }
+    *out_obj=os;
+    return ps*2>=n && os>=8 && os*3>=ps*2;
+}
+static int wanted(const char*tail){
+    if(strstr(tail,"[anon:libc_malloc]")||strstr(tail,"[heap]"))return 1;
+    if(strchr(tail,'/')||strchr(tail,'['))return 0;
+    return 1;
+}
+static void maps(FILE*m){
+    char line[1024];rewind(m);
+    while(fgets(line,sizeof line,m)){
+        unsigned long long lo=0,hi=0,off=0;char pm[8]={0};int used=0;
+        if(sscanf(line,"%llx-%llx %7s %llx %*s %*s %n",&lo,&hi,pm,&off,&used)<4)continue;
+        if(strncmp(pm,"rw-p",4)||lo<0x1000000000ULL||!wanted(line+used)||hi<=lo||hi-lo>0x10000000ULL)continue;
+        if(rn<1024)ranges[rn++]=(struct range){lo,hi};
+    }
+}
+static void addhit(uint64_t level,uint64_t arr,unsigned off,int count){
+    for(unsigned i=0;i<hn;i++)if(hits[i].level==level&&hits[i].off==off)return;
+    if(hn<128)hits[hn++]=(struct hit){level,arr,off,count};
+}
+static void find_levels(void){
+    uint8_t pg[0x1000];unsigned pages=0,objs=0;
+    for(unsigned r=0;r<rn;r++)for(uint64_t at=ranges[r].lo;at<ranges[r].hi;at+=sizeof pg){
+        uint64_t n=ranges[r].hi-at;if(n>sizeof pg)n=sizeof pg;
+        if(rd(at,pg,n)!=0)continue;pages++;
+        for(uint64_t i=0;i+0x20<=n;i+=8){
+            uint64_t vt=cl(*(uint64_t*)(pg+i));if(!inlib(vt))continue;
+            uint64_t cls=cl(*(uint64_t*)(pg+i+0x10));if(!ptr(cls))continue;
+            uint64_t cvt=0;if(rd(cls,&cvt,8)!=0||!inlib(cvt))continue;
+            uint64_t obj=at+i;objs++;
+            uint8_t b[0x380]={0};if(rd(obj,b,sizeof b)!=0)continue;
+            if(obj==0x70c6a129b0ULL){
+                uint64_t da=cl(*(uint64_t*)(b+0xc8));
+                int dc=*(int*)(b+0xd0),dp=*(int*)(b+0xd4),dos=0;
+                int dok=actor_array(da,dc,&dos);
+                fprintf(stderr,"direct_probe obj=0x%llx arr=0x%llx count=%d cap=%d objects=%d ok=%d\n",
+                    (unsigned long long)obj,(unsigned long long)da,dc,dp,dos,dok);
+            }
+            for(unsigned o=0x40;o<=0x360;o+=8){
+                uint64_t arr=cl(*(uint64_t*)(b+o));int c=*(int*)(b+o+8),cap=*(int*)(b+o+12);
+                if(!ptr(arr)||c<20||c>5000||cap<c||cap>c*2+128)continue;
+                int os=0;if(!actor_array(arr,c,&os))continue;
+                uint32_t idx=0;rd(cls+0x18,&idx,4);
+                printf("level_candidate level=0x%llx class=0x%llx class_idx=%u actors_off=0x%x actors=0x%llx count=%d cap=%d sample_objects=%d\n",
+                    (unsigned long long)obj,(unsigned long long)cls,idx,o,(unsigned long long)arr,c,cap,os);
+                addhit(obj,arr,o,c);fflush(stdout);
+            }
+        }
+    }
+    fprintf(stderr,"level_scan pages=%u uobjects=%u hits=%u\n",pages,objs,hn);
+}
+static void find_worlds(void){
+    uint8_t pg[0x1000];unsigned wh=0;
+    for(unsigned r=0;r<rn;r++)for(uint64_t at=ranges[r].lo;at<ranges[r].hi;at+=sizeof pg){
+        uint64_t n=ranges[r].hi-at;if(n>sizeof pg)n=sizeof pg;if(rd(at,pg,n)!=0)continue;
+        for(uint64_t i=0;i+8<=n;i+=8){uint64_t v=cl(*(uint64_t*)(pg+i));
+            for(unsigned h=0;h<hn;h++)if(v==hits[h].level){uint64_t field=at+i;
+                for(unsigned o=0x20;o<=0x200;o+=8){if(field<o)break;uint64_t world=field-o;
+                    if(exact_uobject(world)){
+                        printf("world_candidate world=0x%llx level_off=0x%x level=0x%llx actors_off=0x%x count=%d\n",
+                            (unsigned long long)world,o,(unsigned long long)v,hits[h].off,hits[h].count);wh++;
+                    }
+                }
+            }
+        }
+    }
+    fprintf(stderr,"world_hits=%u\n",wh);
+}
+int main(int argc,char**argv){
+    if(argc!=2)return 2;pid=(uint32_t)strtoul(argv[1],0,10);
+    syscall(__NR_reboot,(long)M1,(long)M2,0x1234567L,&fd);if(fd<0)return 3;
+    char mp[64],line[1024];snprintf(mp,sizeof mp,"/proc/%u/maps",pid);FILE*m=fopen(mp,"r");if(!m)return 4;
+    while(fgets(line,sizeof line,m)){unsigned long long lo,hi,off;char pm[8];if(strstr(line,"libUE4.so")&&sscanf(line,"%llx-%llx %7s %llx",&lo,&hi,pm,&off)==4){if(off==0&&!base)base=lo;if(hi>end)end=hi;}}
+    maps(m);fclose(m);fprintf(stderr,"pid=%u lib=0x%llx-0x%llx ranges=%u\n",pid,(unsigned long long)base,(unsigned long long)end,rn);
+    find_levels();if(hn)find_worlds();return hn?0:1;
+}
