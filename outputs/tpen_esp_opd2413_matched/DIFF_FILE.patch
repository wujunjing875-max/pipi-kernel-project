index 0000000000000000000000000000000000000000..c15dffea6150b7f66fe24e3adf747811e8c2e602
--- /dev/null
+++ b/tools/scan_named_uobjects.c
@@ -0,0 +1,48 @@
+#define _GNU_SOURCE
+#include <sys/ioctl.h>
+#include <sys/syscall.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
