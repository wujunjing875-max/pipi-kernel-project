+static uint64_t scan_named_uclass(uint32_t name_id){
+    if(!ARENA_LO||!ARENA_HI) return 0;
+    uint64_t start=ARENA_LO&~0x0fffffffULL, stop=ARENA_LO+0x400000000ULL;
+    if(stop>ARENA_HI) stop=ARENA_HI;
